# Neon PostgreSQL — required. Get from your Neon project dashboard.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Neon API key — used for management operations (optional, only needed for scripts)
NEON_API_KEY=your_neon_api_key_here

# Storage API token — protects the /api/storage endpoint.
# Set this to any long random string (40+ chars). Must match in Vercel env vars AND here.
# Generate one with: node -e "console.log(require('crypto').randomBytes(30).toString('hex'))"
STORAGE_TOKEN=your_secure_random_token_here

# Optional local server port
PORT=3000
